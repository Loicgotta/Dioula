# Configuration pour déploiement sur Render
# Copiez ce fichier en .env pour le développement local

# Port du serveur (Render définira automatiquement PORT)
PORT=3000

# Clé API Djelia
DJELIA_API_KEY=votre-cle-api-djelia

# Clés API ElevenLabs
ELEVENLABS_API_KEY=votre-cle-api-elevenlabs
ELEVENLABS_VOICE_ID=votre-voice-id-elevenlabs

# URL du webhook n8n
N8N_WEBHOOK_URL=https://n8n.srv793731.hstgr.cloud/webhook/dioula

# Environnement
NODE_ENV=production
